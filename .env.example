# ===========================================
# AI Video Generator - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# Backend API URLs (Required)
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_VIDEO_GEN_API_URL=

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URL=

# GitHub OAuth
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_REDIRECT_URL=

# Microsoft OAuth
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_REDIRECT_URL=

# Apple OAuth
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URL=

# Azure OpenAI Image Generation (server-side; do not expose as NEXT_PUBLIC)
AZURE_API_KEY=
AZURE_OPENAI_IMAGE_ENDPOINT=https://jack-m6wyg7rf-eastus2.openai.azure.com
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_OPENAI_IMAGE_API_VERSION=2024-02-01

# External App URLs
NEXT_PUBLIC_CHATBOT_URL=
NEXT_PUBLIC_MYNOTEBOOKLM_URL=
